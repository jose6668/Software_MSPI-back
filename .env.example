# Plantilla pública. Spring Boot no carga automáticamente este archivo.
# Proporcionar los valores por variables de entorno o configuración externa.
# No guardar ni completar secretos en esta plantilla versionada.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/mspi
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Mantener funciones opcionales cerradas hasta configurar cada entorno.
MSPI_TENANCY_ENABLED=false
MSPI_INVITATIONS_ENABLED=false
MSPI_RECOVERY_ENABLED=false
MSPI_EVIDENCE_ENABLED=false

# HTTPS: el lanzador lee las claves desde un directorio privado externo a Git.
# MSPI_TLS_KEYSTORE es una URI file:/// absoluta; no incrustar el almacen en el JAR.
MSPI_TLS_KEYSTORE=
MSPI_TLS_KEYSTORE_PASSWORD=
MSPI_HTTPS_PORT=8443
MSPI_HTTPS_LAN_ADDRESS=
